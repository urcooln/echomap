# Local Vite frontend
PORT=5173
BASE_PATH=/
DEV_API_ORIGIN=http://localhost:3001

# Clerk browser key. This is publishable, but keep environment-specific values
# in .env files or deployment variables so staging and production do not drift.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PROXY_URL=/api/__clerk

# Local dev enables the demo automatically. Set this to true only for public
# staging builds that intentionally expose synthetic demo data.
VITE_ENABLE_DEVELOPMENT_DEMO=false
