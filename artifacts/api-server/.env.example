# Local development
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echomap_dev?sslmode=disable
PUBLIC_APP_ORIGIN=http://localhost:5173
ALLOWED_APP_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Authentication
ECHOMAP_AUTH_MODE=clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_ALLOW_DEV_PROXY=true

# Local private data protection
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
# Optional in local dev; production must set a 32-byte base64 or 64-character hex key.
# Generate with: openssl rand -base64 32
ECHOMAP_DATA_ENCRYPTION_KEY=

# Local recording storage. For development, local-encrypted stores encrypted files
# under artifacts/api-server/.data/echomap-sessions/audio.
ECHOMAP_AUDIO_STORAGE_DRIVER=local-encrypted

# Replit App Storage mode, kept for compatibility when running on Replit.
# ECHOMAP_AUDIO_STORAGE_DRIVER=app-storage
# PRIVATE_OBJECT_DIR=/private-bucket/private-prefix

# Cloud Run staging / production object storage.
# ECHOMAP_AUDIO_STORAGE_DRIVER=gcs
# GCS_PRIVATE_BUCKET=echomap-staging-private
# GCS_PRIVATE_OBJECT_PREFIX=staging

# Staging-only public synthetic demo.
ECHOMAP_ENABLE_DEMO_LOGIN=false

# Set true only after legacy S3 recording rows have been migrated or are not used.
ECHOMAP_LEGACY_S3_MIGRATION_COMPLETE=true

# Legacy S3 recording access, required until migration is complete.
# ECHOMAP_S3_BUCKET=
# ECHOMAP_S3_REGION=
# ECHOMAP_S3_ACCESS_KEY_ID=
# ECHOMAP_S3_SECRET_ACCESS_KEY=
# ECHOMAP_S3_ENDPOINT=
# ECHOMAP_S3_SESSION_TOKEN=
# ECHOMAP_S3_FORCE_PATH_STYLE=false

# AI integration used for transcription and generated clinical drafts.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=replace_me

# Production static frontend path. The Dockerfile sets this automatically.
# ECHOMAP_STATIC_DIR=/app/artifacts/api-server/dist/public
