# Local development
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/childled_dev?sslmode=disable
PUBLIC_APP_ORIGIN=http://localhost:5173
ALLOWED_APP_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Authentication
CHILDLED_AUTH_MODE=clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_ALLOW_DEV_PROXY=true
# Optional locally. Production always sends Clerk application invitations.
CHILDLED_CLERK_INVITATIONS_ENABLED=false

# Local private data protection
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
# Optional in local dev; production must set a 32-byte base64 or 64-character hex key.
# Generate with: openssl rand -base64 32
CHILDLED_DATA_ENCRYPTION_KEY=

# Local recording storage. For development, local-encrypted stores encrypted files
# under artifacts/api-server/.data/childled-sessions/audio.
CHILDLED_AUDIO_STORAGE_DRIVER=local-encrypted

# Replit App Storage mode, kept for compatibility when running on Replit.
# CHILDLED_AUDIO_STORAGE_DRIVER=app-storage
# PRIVATE_OBJECT_DIR=/private-bucket/private-prefix

# Cloud Run staging / production object storage.
# CHILDLED_AUDIO_STORAGE_DRIVER=gcs
# GCS_PRIVATE_BUCKET=childled-staging-private
# GCS_PRIVATE_OBJECT_PREFIX=staging

# Owner-only synthetic demo. Staging additionally requires
# CHILDLED_DEPLOYMENT_ENVIRONMENT=staging and an access key of 32+ characters.
CHILDLED_DEPLOYMENT_ENVIRONMENT=development
CHILDLED_ENABLE_DEMO_LOGIN=false
# Required when CHILDLED_ENABLE_DEMO_LOGIN=true. Generate with: openssl rand -base64 32
CHILDLED_DEMO_ACCESS_KEY=

# Set true only after legacy S3 recording rows have been migrated or are not used.
CHILDLED_LEGACY_S3_MIGRATION_COMPLETE=true

# Legacy S3 recording access, required until migration is complete.
# CHILDLED_S3_BUCKET=
# CHILDLED_S3_REGION=
# CHILDLED_S3_ACCESS_KEY_ID=
# CHILDLED_S3_SECRET_ACCESS_KEY=
# CHILDLED_S3_ENDPOINT=
# CHILDLED_S3_SESSION_TOKEN=
# CHILDLED_S3_FORCE_PATH_STYLE=false

# AI integration used for transcription and generated clinical drafts.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=replace_me

# Production static frontend path. The Dockerfile sets this automatically.
# CHILDLED_STATIC_DIR=/app/artifacts/api-server/dist/public
